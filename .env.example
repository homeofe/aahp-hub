# Root directory to scan for AAHP projects
# Defaults to ~/Workspace if not set
ROOT_DIR=/Users/yourname/Workspace

# Path to the aahp-runner metrics JSONL file
# Defaults to ~/.aahp/metrics.jsonl (where aahp-runner writes)
# METRICS_FILE=/Users/yourname/.aahp/metrics.jsonl

# Path to the aahp-runner live sessions file
# Defaults to ~/.aahp/sessions.json (written by aahp-runner / aahp-orchestrator)
# SESSIONS_FILE=/Users/yourname/.aahp/sessions.json
